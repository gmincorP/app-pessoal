# Copie para backend/.env e preencha. NUNCA suba o .env pro GitHub.
PGHOST=localhost
PGPORT=5432
PGDATABASE=app_pessoal
PGUSER=app_pessoal
PGPASSWORD=TROCAR

# Porta do servico (o ERP usa 5000/5001)
APP_PORT=5100
# Token exigido em toda chamada /api (header X-Token) -- gere um aleatorio
APP_TOKEN=TROCAR

# Pluggy (dashboard.pluggy.ai -> API Keys). Plano Meu Pluggy: gratis, uso pessoal.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# IDs dos items conectados (Nubank, Mercado Pago, Inter), separados por virgula
PLUGGY_ITEM_IDS=
# Quantos dias pra tras re-sincronizar (pega lancamentos pendentes que mudaram)
PLUGGY_JANELA_DIAS=10
